c4ml draft-1

// Original executable fixture for the four static C4 zoom levels.

model {
  person workshop-lead {
    name = "Workshop Lead"
    responsibility = "Reviews workspace arrangements and chooses a plan."
    classification = external
  }

  system workshop-lens {
    name = "Workshop Lens"
    responsibility = "Builds reviewable workspace plans from requests and material observations."
    classification = internal
  }

  system material-feed {
    name = "Material Feed"
    responsibility = "Publishes current material dimensions and availability."
    classification = external
  }

  container browser-studio inside workshop-lens {
    name = "Browser Studio"
    responsibility = "Collects planning requests and presents proposed arrangements."
    technology = "TypeScript web application"
  }

  container planning-service inside workshop-lens {
    name = "Planning Service"
    responsibility = "Evaluates constraints and produces workspace arrangements."
    technology = "TypeScript service"
  }

  container plan-store inside workshop-lens {
    name = "Plan Store"
    responsibility = "Stores arrangement versions and review decisions."
    technology = "PostgreSQL"
  }

  component request-gateway inside planning-service {
    name = "Request Gateway"
    responsibility = "Validates planning requests and translates transport data."
    technology = "TypeScript component"
  }

  component arrangement-engine inside planning-service {
    name = "Arrangement Engine"
    responsibility = "Ranks possible arrangements against workshop constraints."
    technology = "TypeScript component"
  }

  code constraint-normalizer inside arrangement-engine {
    name = "Constraint Normalizer"
    responsibility = "Converts authored constraints into comparable planning rules."
    code-kind = module
    language = "TypeScript"
  }

  code candidate-ranker inside arrangement-engine {
    name = "Candidate Ranker"
    responsibility = "Orders candidate arrangements by their satisfied constraints."
    code-kind = function
    language = "TypeScript"
  }
}

relations {
  relation lead-reviews-lens {
    from = workshop-lead
    to = workshop-lens
    intent = "Reviews proposed workspace arrangements"
  }

  relation feed-supplies-lens {
    from = material-feed
    to = workshop-lens
    intent = "Supplies material observations"
  }

  relation lead-edits-studio {
    from = workshop-lead
    to = browser-studio
    intent = "Authors constraints and reviews arrangements"
  }

  relation studio-requests-plan {
    from = browser-studio
    to = planning-service
    intent = "Requests a ranked workspace arrangement"
    technology = "HTTPS/JSON"
  }

  relation service-writes-plan {
    from = planning-service
    to = plan-store
    intent = "Stores arrangement versions"
    protocol = "PostgreSQL wire protocol"
  }

  relation gateway-invokes-engine {
    from = request-gateway
    to = arrangement-engine
    intent = "Requests ranked candidate arrangements"
  }

  relation normalizer-feeds-ranker {
    from = constraint-normalizer
    to = candidate-ranker
    intent = "Provides normalized constraints"
  }
}

view workshop-lens-components {
  type = component
  scope = planning-service
  title = "Component View — Planning Service"
  purpose = "Shows the internal responsibilities used to produce workspace arrangements."
  audience = default
  legend = generated

  layout {
    flow = right
  }
}

view arrangement-engine-code {
  type = code
  scope = arrangement-engine
  title = "Code View — Arrangement Engine"
  purpose = "Shows the implementation elements that normalize and rank arrangement constraints."
  audience = default
  legend = generated

  layout {
    flow = right
  }
}

view workshop-lens-containers {
  type = container
  scope = workshop-lens
  title = "Container View — Workshop Lens"
  purpose = "Shows the deployable responsibilities inside Workshop Lens."
  audience = default
  legend = generated

  layout {
    flow = right
  }
}

view workshop-lens-context {
  type = system-context
  scope = workshop-lens
  title = "System Context — Workshop Lens"
  purpose = "Shows who uses Workshop Lens and which external system supplies it."
  audience = default
  legend = generated

  layout {
    flow = right
  }
}
