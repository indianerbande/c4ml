{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "c4ml-editor": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "c4ml",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "../../build/editor",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [],
            "tsConfig": "tsconfig.app.json",
            "webWorkerTsConfig": "tsconfig.worker.json",
            "assets": [
              {
                "glob": "editor.main.css",
                "input": "node_modules/monaco-editor/min/vs/editor",
                "output": "monaco"
              },
              {
                "glob": "LICENSE",
                "input": "node_modules/monaco-editor",
                "output": "third-party/monaco-editor"
              },
              {
                "glob": "ThirdPartyNotices.txt",
                "input": "node_modules/monaco-editor",
                "output": "third-party/monaco-editor"
              }
            ],
            "loader": {
              ".ttf": "file"
            },
            "styles": ["src/styles.css"],
            "outputHashing": "none"
          },
          "configurations": {
            "production": {
              "optimization": true,
              "sourceMap": false,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2MB",
                  "maximumError": "3MB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "c4ml-editor:build:production"
            },
            "development": {
              "buildTarget": "c4ml-editor:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false,
    "cache": {
      "enabled": false
    }
  }
}
